{
  "private": true,
  "packageManager": "pnpm@12.15.0",
  "scripts": {
    "typecheck": "tsc -b . pi-extension relay mcp",
    "test": "claude plugin test . < /dev/null",
    "validate": "claude plugin validate --strict . < /dev/null",
    "build:relay": "esbuild relay/src/relay.mts --bundle --platform=node --format=esm --target=node22 --legal-comments=inline --outfile=relay/relay.mjs --banner:js='// Built from relay/src/relay.mts by pnpm build:relay; do not edit.'",
    "lint": "biome ci .",
    "format": "biome check --write .",
    "test:relay": "node --test relay/test/",
    "test:mcp": "node --test mcp/test/"
  },
  "devDependencies": {
    "@agentclientprotocol/sdk": "2.0.2",
    "@biomejs/biome": "2.6.3",
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@openai/codex-sdk": "0.164.0",
    "@opencode-ai/sdk": "1.19.4",
    "@types/node": "26.6.5",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "zod": "4.6.7"
  }
}
